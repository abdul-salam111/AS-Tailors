# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real secrets. This file is the
# checked-in template so a fresh clone knows which keys it needs.
#
# After editing .env, regenerate lib/core/constants/env.g.dart with:
#   dart run build_runner build --delete-conflicting-outputs

BASE_URL=https://api.yourapp.com/v1/
APP_TOKEN=replace-with-your-static-app-token

# Supabase project (Project Settings > API in the Supabase dashboard).
# SUPABASE_PUBLISHABLE_KEY is the publishable/anon key — safe for client
# builds, access is governed by RLS. Never put the service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials).
# GOOGLE_SERVER_CLIENT_ID must be a "Web application" OAuth client — not
# the Android/iOS one — because that's the audience Supabase's Google
# provider validates the ID token against. Also enable the Google
# provider in Supabase Dashboard > Authentication > Providers, pasting
# the same client ID + its secret there. Leave blank to leave Google
# sign-in non-functional (the button will show a clear error) until
# you've set this up.
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In needs no app secret here — configuration lives in your
# Apple Developer account (Sign In with Apple capability + Services ID)
# and in Supabase Dashboard > Authentication > Providers > Apple.
