# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real secrets. This file is the
# checked-in template so a fresh clone knows which keys it needs.
#
# After editing .env, regenerate lib/core/constants/env.g.dart with:
#   dart run build_runner build --delete-conflicting-outputs

BASE_URL=https://api.yourapp.com/v1/
APP_TOKEN=replace-with-your-static-app-token

# Supabase project (Project Settings > API in the Supabase dashboard).
# SUPABASE_PUBLISHABLE_KEY is the publishable/anon key — safe for client
# builds, access is governed by RLS. Never put the service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
